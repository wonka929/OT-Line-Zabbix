[Unit]
Description=OT Line Zabbix head (discovery + trapper)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Scapy/DCP richiedono root (raw socket)
User=root
WorkingDirectory=/etc/ot-line-zabbix
ExecStart=/bin/ot-line-zabbix --config /etc/ot-line-zabbix/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
